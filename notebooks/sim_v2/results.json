  "rules": {
    "real_games": {
      "on": true,
      "popularity_weight": "steam200k_players",
      "reason": "Genres, online flag, list size and length belong to a game, so they are taken from a real one; common games are drawn more often.",
      "source": "Steam Store Games (Kaggle, SteamSpy 2019) + Steam 200k player counts"
    },
    "game_hours": {
      "on": true,
      "min_players": 20,
      "cap_quantile": 0.99,
      "reason": "Hours depend on the game's length: a game with >= 20 Steam 200k players takes its hours from its own Steam 200k distribution at the persona's quantile u (capped at its own 99th pct), else from the global one. Drawing hours independently of the game made rule 1 inconsistent (3h on a 40h RPG).",
      "source": "Steam 200k per-game playtime"
    },
    "rule1_finish_needs_hours": {
      "on": true,
      "r_low": 0.5,
      "r_high": 1.5,
      "edge": 0.05,
      "r_mid": 0.8660254037844386,
      "r_scale": 0.1865571500108185,
      "reason": "You can't finish a game without playing it through: P(completed) < 5% of p below half the typical length, >= 95% of p from 1.5x, logistic in ln r between.",
      "source": "Logic; main-story lengths from HowLongToBeat (Bailey et al., arXiv 2205.15163)"
    },
    "rule2_trophies_follow_hours": {
      "on": true,
      "extra_ratio_E": 2.0,
      "story_share_M": 0.6,
      "reason": "Trophies rise with hours to a share M of the list by the end of the main story (r = 1); the remaining 1 - M rises over the extra E x length hours, reachable only on completed games. Full set only when completed and r >= 1 + E. Scaled by the per-game trophy Beta draw.",
      "source": "E: Bailey et al.: +8.6h after the main story for shorter games, +23.6h for full-price ones, about 1.7-2.25x the main story -> E = 2. M = 0.6 is a design parameter, to be checked against survey trophy rates."
    },
    "rule3_multiplayer_only_no_ending": {
      "on": true,
      "p_completed": 0.02,
      "reason": "Live-service games have no ending to reach; 2% allows campaigns the store categories don't show.",
      "source": "Logic"
    },
    "rule4_engagement": {
      "on": true,
      "hours_quantile_shift": 0.05,
      "months_per_z": 1.0,
      "logit_shift": 0.3,
      "reason": "Engaged players play more and also pursue more goals, so one hidden z ~ N(0,1) moves hours, active months and both propensities together, moderately.",
      "source": "Logic"
    },
    "rule5_trophy_hunters": {
      "on": true,
      "share": 0.1,
      "floor_beta": [
        4,
        4
      ],
      "reason": "Some players chase trophies on every game: on every game with a list their trophy fraction is at least a Beta(4,4) draw, even unfinished (never 100%).",
      "source": "Bailey et al.: trophy completion rates are bimodal, easy trophies attributed to players chasing profile scores"
    }
  },
